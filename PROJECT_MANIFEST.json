{
  "projectName": "angular-skill",
  "angularMajorVersion": 21,
  "packageManager": "npm",
  "style": "scss",
  "ssr": true,
  "zoneless": true,
  "routing": true,
  "rxjsLinting": "auto",
  "budgetProfile": "strict",
  "lintersConfigured": true,
  "integrations": [
    {
      "name": "@angular/material",
      "version": "21.2.5",
      "source": "https://material.angular.dev/",
      "notes": [
        "Installed via ng add",
        "Configured Material 3 light and dark themes with design tokens"
      ]
    },
    {
      "name": "tailwindcss",
      "version": "4.2.2",
      "source": "https://tailwindcss.com/docs/installation/framework-guides/angular",
      "notes": [
        "Installed with @tailwindcss/postcss and postcss",
        "Configured in src/tailwind.css with tw: prefix"
      ]
    }
  ],
  "skillVersions": {
    "angular-setup-project": "1.0",
    "angular-linters": "1.0",
    "angular-third-party-integration": "1.0"
  }
}
